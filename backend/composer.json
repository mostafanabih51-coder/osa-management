{
  "name": "online-school-academy/management",
  "type": "project",
  "description": "Online School Academy Management API",
  "require": {"php":"^8.2","laravel/framework":"^12.0","laravel/sanctum":"^4.0"},
  "autoload": {"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "scripts": {"post-autoload-dump":["@php artisan package:discover --ansi"],"post-update-cmd":["@php artisan vendor:publish --tag=laravel-assets --ansi --force"]},
  "config":{"optimize-autoloader":true,"sort-packages":true}
}
